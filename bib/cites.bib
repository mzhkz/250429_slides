  author={Deswarte, Y. and Blain, L. and Fabre, J.-C.},
  booktitle={Proceedings. 1991 IEEE Computer Society Symposium on Research in Security and Privacy}, 
  title={Intrusion tolerance in distributed computing systems}, 
